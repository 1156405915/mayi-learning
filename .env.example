# ============================================================
# agent-learning 环境变量配置模板
# 使用方式：复制本文件为 .env 并填入真实密钥（.env 已被 Git 忽略）
#   cp .env.example .env
# ============================================================

# 时区设置
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# -------------------- 1. 数据源服务地址 --------------------
# 本地宿主机或 SSH 隧道调试填 http://127.0.0.1:1200
# 服务器 Docker 容器内网填 http://rsshub:1200
RSSHUB_BASE_URL=http://127.0.0.1:1200

# 可选：自定义每日新闻启用的 RSSHub 路由（逗号分隔，留空则使用默认 5 个核心源）
# DAILY_NEWS_ROUTES=/thepaper/featured,/cls/telegraph,/wallstreetcn/live,/yicai/brief,/36kr/newsflashes

# 可选：SearXNG 内网搜索服务地址（供后续搜索类 Agent 使用）
SEARXNG_BASE_URL=http://127.0.0.1:8181

# -------------------- 2. 大模型 API 配置 --------------------
# 支持 DeepSeek 官方及任何兼容 OpenAI /chat/completions 的平台（硅基流动、火山方舟等）
LLM_API_KEY=sk-在这里替换成你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# -------------------- 3. 飞书推送配置 --------------------
# 方式 A：飞书开放平台自建应用（推荐，可向指定 chat_id 或 open_id 发消息）
FEISHU_APP_ID=cli_在这里替换成你的飞书AppID
FEISHU_APP_SECRET=在这里替换成你的飞书AppSecret
FEISHU_RECEIVE_ID=oc_7c47fc54e8d20731953bc3fbc07da00b
FEISHU_RECEIVE_ID_TYPE=chat_id

# 方式 B（可选）：飞书群自定义机器人 Webhook（若开启了签名校验可同时填写 SECRET）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
